digraph Relations {
  graph [rankdir=TB bgcolor="white" pad=0.2 nodesep=.35 ranksep=.46 dpi=150]
  node [shape=box style="rounded,filled" fillcolor="#f0f6fa" color="#9ab5c5" fontcolor="#17324e" fontname="DejaVu Sans" fontsize=10]
  edge [color="#607d8d" fontname="DejaVu Sans" fontsize=8 arrowsize=.6]
  C [label="customers\nPK id"]
  A [label="accounts\nPK id; FK customer_id"]
  L [label="ledger\nPK reference; FK account_id"]
  T [label="transfers\nFK source; FK destination"]
  B [label="beneficiaries\nPK owner + target"]
  P [label="loans / deposits\nFK customer_id"]
  Card [label="cards\nPK/FK customer_id"]
  E [label="card_entries\nFK customer_id"]
  Cases [label="cases\nPK reference; FK customer_id"]
  O [label="operations\nPK token; FK customer_id"]
  Audit [label="audit\nPseudonymous session tag"]
  C -> A [label="1 : 1"]
  C -> B [label="1 : many"]
  A -> B [label="target"]
  A -> L [label="1 : many"]
  A -> T [label="source / destination"]
  C -> P [label="1 : many"]
  C -> Card [label="1 : 1"]
  Card -> E [label="1 : many"]
  C -> Cases [label="1 : many"]
  C -> O [label="1 : many"]
  O -> Audit [label="same write" style=dashed]
  {rank=same; A P Card Cases O}
}
